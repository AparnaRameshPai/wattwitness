# Copy to .env and fill in. NEVER commit .env.
# The key: on the Vultr VM it lives in /etc/agent/inference.env (VULTR_INFERENCE_API_KEY=...), loaded by systemd,
# so leave it empty here. For local runs you can put it here instead.
VULTR_INFERENCE_KEY=
LLM_BASE_URL=https://api.vultrinference.com/v1
# Pick from: curl https://api.vultrinference.com/v1/models
# Tested on 26 Nov 2026: deepseek-v4.1-flash-1017 is fastest for code/JSON; qwen3.8-27b is reliable for vision.
LLM_MODEL=deepseek-v4.1-flash-1017
# Optional: a different model for the verifier (stronger independence). Empty = same as LLM_MODEL.
VERIFIER_MODEL=qwen3.8-27b
# Optional: a vision-capable model that critiques every chart. Empty = off.
VISION_MODEL=qwen3.8-27b
# Optional: model for the red-team agent. Empty = same as LLM_MODEL.
# Tested: mimo-v2.6-flash writes the attacks most reliably (several others return nothing).
REDTEAM_MODEL=mimo-v2.6-flash
# Max tokens per reply (reasoning models think first; 2500 cut scripts off).
LLM_MAX_TOKENS=8000
# Re-run every successful task in a fresh sandbox and compare output hashes.
REPLAY=true

# Shown in the website's Vultr sidebar (region/hostname come from the Vultr metadata service automatically).
VULTR_PLAN=vc2-4c-8gb

SANDBOX_IMAGE=receipts-sandbox:latest
# On the Vultr VM set this to runsc after installing gVisor. Leave empty on Windows/Mac.
SANDBOX_RUNTIME=
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1
# Process cap inside each sandbox (--ulimit nproc). The cgroup --pids-limit is only a high backstop:
# under gVisor a low --pids-limit crashes the sandbox itself instead of refusing the fork.
SANDBOX_PIDS=64
SANDBOX_PIDS_BACKSTOP=1024
SANDBOX_TIMEOUT=30
MAX_ATTEMPTS=3
MAX_TASKS=4
MAX_UPLOAD_MB=20
# Public-demo protection: sandboxes running at once on the VM (others queue), and analyses/attacks at once
# in total (one per visitor).
MAX_PARALLEL_SANDBOXES=6
MAX_ACTIVE_RUNS=3
